# Copy to .env for local development; never commit populated environment files.
# Required application settings. Supply a JWT secret of at least 32 bytes.
DATABASE_URL=
JWT_SECRET=
AWS_REGION=
AWS_BUCKET_NAME=

# Optional: defaults shown; production must set NODE_ENV and the actual origin.
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# AWS credentials are NOT application-required variables. Use the SDK default
# chain: a local AWS profile/SSO, standard AWS environment variables (including
# AWS_SESSION_TOKEN for temporary credentials), or a production workload role.
# Never put real AWS credentials in this example.

# Optional demo seed overrides; leave unset to retain existing demo defaults.
# SEED_PASSWORD=
# SEED_TRIAL_PASSWORD=
