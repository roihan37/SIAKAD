model TahunAkademik {
  id          Int   @id @default(autoincrement())
  tahun       String
  semester    Semester
  isActive    Boolean  @default(false)

  kelas       Kelas[]
  jadwal      Jadwal[]
  krs         KRS[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([tahun, semester])
}

