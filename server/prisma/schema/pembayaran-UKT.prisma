model PembayaranUKT {
  id                  String             @id @default(uuid())
  tagihanId           String

  nomorPembayaran     String             @unique
  nominal             Decimal            @db.Decimal(15, 2)

  metode              MetodePembayaran
  status              StatusPembayaran   @default(PENDING)

  sumber              SumberPembayaran?

  reference           String?
  buktiPembayaranKey  String?

  paidAt              DateTime?
  verifiedAt          DateTime?
  verifiedById        String?

  tagihan             TagihanUKT         @relation( fields: [tagihanId], references: [id] )

  riwayatStatus       RiwayatStatusPembayaran[]

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([tagihanId])
  @@index([status])
  @@index([createdAt])
}