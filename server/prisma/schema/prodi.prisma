model Prodi {
  id         Int         @id @default(autoincrement())
  kode       String      @unique
  name       String
  fakultasId Int
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  dosen      Dosen[]
  mahasiswa  Mahasiswa[]
    // kurikulum   Kurikulum[]
    // kelas       Kelas[]
  fakultas   Fakultas    @relation(fields: [fakultasId], references: [id])
}
